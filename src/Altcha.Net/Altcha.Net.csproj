<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;netstandard2.0;net10.0</TargetFrameworks>
    <PackageId>Altcha.Net</PackageId>
    <Version>1.1.0</Version>
    <Description>Self-hosted ALTCHA proof-of-work validation for .NET Framework, .NET Standard and modern .NET applications.</Description>
    <PackageTags>altcha;captcha;proof-of-work;aspnet;dotnet;security</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Altcha.Net.Tests" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <Reference Include="System.Web.Extensions" Condition="'$(TargetFramework)' == 'net48'" />
    <PackageReference Include="System.Text.Json" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net48'" />
  </ItemGroup>

</Project>
